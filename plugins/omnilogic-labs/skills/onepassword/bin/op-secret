#!/bin/bash
# op-secret: read a secret from 1Password and emit it CLEAN.
#
# Solves the three things that make `op` unreliable for keys and tokens:
#   1. binary resolution: the first `op` that lists an account; under WSL the
#      Windows `op.exe` (found even off PATH) before a Linux `op`
#   2. revealing concealed fields (otherwise you get a reference, not the value)
#   3. stripping Windows carriage returns and the wrapping double-quotes that
#      `--reveal` adds around multiline values (SSH private keys)
#
# Status goes to stderr; the secret (or nothing, when writing a file) is the
# only thing on stdout.
set -e

usage() {
  cat >&2 << 'EOF'
Usage:
  op-secret <op://vault/item/field> [--out FILE] [--cache FILE] [--account A]
  op-secret --item NAME --field FIELD [--vault V] [--account A] [--out FILE] [--cache FILE]

Reads a secret from 1Password and prints it to stdout, or writes it to --out
(mode 600). Strips carriage returns and the wrapping quotes 1Password adds to
revealed multiline values.

Options:
  --item NAME    Item title (use with --field).
  --field FIELD  Field or label to read (e.g. "private key", "password", "credential").
  --vault V      Vault name (optional; disambiguates duplicate item titles).
  --account A    1Password account (optional).
  --out FILE     Write to FILE (mode 600) instead of stdout.
  --cache FILE   Reuse FILE if it is non-empty; otherwise fetch and store it
                 there (mode 600). Use this to avoid repeated unlock prompts.
  -h, --help     Show this help.

Environment:
  OP_BIN         The op binary to use. Otherwise the first that lists an
                 account; under WSL, the Windows op.exe before a Linux op.
EOF
  exit 2
}

is_wsl() {
  [ -n "$WSL_DISTRO_NAME" ] || grep -qi microsoft /proc/version 2> /dev/null
}

# Every op binary worth trying, in order, one per line. Under WSL the Windows
# op.exe comes first: it talks to the desktop app, while a Linux `op` there
# usually has no accounts. op.exe is often not on PATH, so look where WinGet
# and the installer put it.
candidates() {
  if is_wsl; then
    command -v op.exe 2> /dev/null || true
    local f
    for f in /mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Links/op.exe \
      /mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Packages/AgileBits.1Password.CLI_*/op.exe \
      "/mnt/c/Program Files/1Password CLI/op.exe"; do
      [ -f "$f" ] && echo "$f"
    done
    command -v op 2> /dev/null || true
  else
    command -v op 2> /dev/null || true
    command -v op.exe 2> /dev/null || true
  fi
}

# Use OP_BIN if set. With a service account token, which needs no configured
# account, prefer a native `op`: WSL does not pass the token to op.exe unless
# WSLENV names it. With one candidate, use it. Otherwise use the first that
# lists an account, so a Linux `op` with none does not hide a working op.exe.
resolve_op() {
  if [ -n "$OP_BIN" ]; then
    echo "$OP_BIN"
    return
  fi
  local list first c
  list=$(candidates | awk '!seen[$0]++')
  first=$(printf '%s\n' "$list" | head -n 1)
  if [ -z "$first" ]; then
    echo "op-secret: 1Password CLI not found. Install 'op' (https://developer.1password.com/docs/cli/), or on WSL install the Windows CLI (op.exe)." >&2
    exit 1
  fi
  if [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ] && command -v op > /dev/null 2>&1; then
    command -v op
    return
  fi
  if [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ] || [ "$(printf '%s\n' "$list" | wc -l)" -eq 1 ]; then
    echo "$first"
    return
  fi
  while IFS= read -r c; do
    if [ -n "$("$c" account list 2> /dev/null | tr -d '\r')" ]; then
      echo "$c"
      return
    fi
  done <<< "$list"
  echo "op-secret: no 1Password CLI lists an account; tried: $(printf '%s\n' "$list" | paste -sd ',' - | sed 's/,/, /g')" >&2
  echo "$first"
}

REF="" ITEM="" FIELD="" VAULT="" ACCOUNT="" OUT="" CACHE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --item)
      ITEM="$2"
      shift 2
      ;;
    --field)
      FIELD="$2"
      shift 2
      ;;
    --vault)
      VAULT="$2"
      shift 2
      ;;
    --account)
      ACCOUNT="$2"
      shift 2
      ;;
    --out)
      OUT="$2"
      shift 2
      ;;
    --cache)
      CACHE="$2"
      shift 2
      ;;
    -h | --help) usage ;;
    op://*)
      REF="$1"
      shift
      ;;
    *)
      echo "op-secret: unexpected argument: $1" >&2
      usage
      ;;
  esac
done

# --cache implies a file destination.
if [ -n "$CACHE" ]; then
  OUT="${OUT:-$CACHE}"
  if [ -s "$CACHE" ]; then
    if [ "$OUT" != "$CACHE" ]; then
      cat "$CACHE" > "$OUT"
      chmod 600 "$OUT"
    fi
    echo "op-secret: using cached secret at $CACHE" >&2
    exit 0
  fi
fi

OP="$(resolve_op)"

# Strip CRs, then unwrap the double-quotes `--reveal` puts around a value.
#
# It does this two different ways and the helper has to handle both. A MULTILINE
# note comes back with the quotes on their own lines, top and bottom. A value
# that fits on ONE line comes back as `"secret"`: quotes inline, same line.
# Only the first case was handled, so a single-line quote-wrapped secret was
# delivered with its quotes still attached: a Fly API macaroon read this way
# authenticated as nobody and every call 401'd, with nothing in the output to
# say why.
#
# Both quotes must be present before either is removed, so a secret that merely
# starts or ends with a quote character is left alone.
clean() {
  tr -d '\r' | sed '1{/^"$/d}' | sed '${/^"$/d}' \
    | awk 'NR==1{first=$0} {n=NR; line[NR]=$0}
           END{
             if (n==1 && first ~ /^".*"$/) { sub(/^"/,"",first); sub(/"$/,"",first); print first }
             else { for (i=1;i<=n;i++) print line[i] }
           }'
}

fetch() {
  if [ -n "$REF" ]; then
    set -- read "$REF"
    [ -n "$ACCOUNT" ] && set -- "$@" --account "$ACCOUNT"
    "$OP" "$@"
  elif [ -n "$ITEM" ] && [ -n "$FIELD" ]; then
    set -- item get "$ITEM" --fields "$FIELD" --reveal
    [ -n "$VAULT" ] && set -- "$@" --vault "$VAULT"
    [ -n "$ACCOUNT" ] && set -- "$@" --account "$ACCOUNT"
    "$OP" "$@"
  else
    usage
  fi
}

# Fetch into a temp file (preserves exact newlines for multiline keys) so we can
# inspect the exit status. A locked desktop app makes the read itself pop the
# unlock prompt; we only surface guidance if the read genuinely fails, so we
# never block a read that just needed an unlock.
tmp="$(mktemp)"
err="$(mktemp)"
trap 'rm -f "$tmp" "$err"' EXIT
set +e
fetch > "$tmp" 2> "$err"
status=$?
set -e

if [ "$status" -ne 0 ]; then
  if grep -qi "no accounts configured" "$err" && is_wsl; then
    echo "op-secret: $OP has no accounts. On WSL that usually means the wrong binary, not no access:" >&2
    echo "  the working CLI is the Windows op.exe, which uses the desktop app. Set OP_BIN to its path and retry." >&2
  elif grep -qiE "not (currently )?signed in|not authorized|isn't authorized|no account" "$err"; then
    echo "op-secret: $OP could not read (not signed in / not authorized). This does NOT mean 1Password is unavailable." >&2
    echo "  Enable the desktop app CLI integration (Settings > Developer > Integrate with 1Password CLI) and unlock the app;" >&2
    echo "  the first read pops a one-time desktop approval to accept, then retry. For headless use, export OP_SERVICE_ACCOUNT_TOKEN." >&2
  else
    cat "$err" >&2
  fi
  exit "$status"
fi

if [ -n "$OUT" ]; then
  umask 077
  clean < "$tmp" > "$OUT"
  chmod 600 "$OUT"
  echo "op-secret: wrote secret to $OUT (mode 600)" >&2
else
  clean < "$tmp"
fi
