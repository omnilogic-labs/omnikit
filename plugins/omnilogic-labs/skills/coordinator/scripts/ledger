#!/bin/bash
set -e
# ledger: the coordinator's ledger, in GitHub issues or a local file.
# Status goes to stderr, data to stdout. Only the coordinator runs the writes.
#
#   ledger config                    print mode, repo, run, project and plan dir
#   ledger labels                    create the label set (idempotent)
#   ledger init <goal>               open a run epic (or start .agents/ledger.md)
#   ledger import <plan.md>          one task issue per "## Task: <name>", as
#                                    sub-issues of the run; skips existing names
#   ledger state <task> <state> [--round N]
#                                    planned building verifying fixing passed
#                                    blocked merged dropped
#   ledger note <task|run> <file|-> [--head TEXT]   a result, as a comment
#   ledger ruling <task|run> <file|-> --by WHO [--date YYYY-MM-DD]
#                                    an owner ruling, verbatim, quoted
#   ledger land <wave> <sha> <task...> [--check TEXT]
#                                    close the tasks as landed; one run comment
#   ledger now <file|->              replace the run's "Now" section
#   ledger ref <task>                print owner/repo#n (or plan#task)
#   ledger status                    the resume view, about 30 lines
#   ledger sync                      replay writes queued while GitHub failed
#
# <task> is a task name, an issue number or #n. --run N (or LEDGER_RUN) picks
# the run when more than one is open. Settings come from .agents/coordinator.md
# (see references/config.md): "ledger", "ledger repo", "project", "plan dir".

die() {
  echo "ledger: $*" >&2
  exit 1
}
say() { echo "ledger: $*" >&2; }

usage() {
  sed -n '3,25s/^# \{0,1\}//p' "$0" >&2
  exit "${1:-1}"
}

command -v realpath > /dev/null && SELF="$(realpath "$0")" || SELF="$0"
MAIN="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" || die "not inside a git repository"
MAIN="$(dirname "$MAIN")"
CONFIG="$MAIN/.agents/coordinator.md"
FILE="$MAIN/.agents/ledger.md"
QUEUE="$MAIN/.agents/ledger-queue.jsonl"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
ZW="$(printf '\342\200\213')"

# cfg <key>: the value of a "key: value" line in the config, if any.
cfg() {
  [ -f "$CONFIG" ] || return 0
  awk -v key="$1" '
    {
      line = $0
      sub(/^[[:space:]]*[-*][[:space:]]*/, "", line)
      gsub(/\*\*/, "", line)
      i = index(line, ":")
      if (i == 0) next
      k = tolower(substr(line, 1, i - 1))
      if (k != key) next
      v = substr(line, i + 1)
      gsub(/`/, "", v)
      sub(/^[[:space:]]+/, "", v)
      sub(/[[:space:]]+$/, "", v)
      print v
      exit
    }' "$CONFIG"
}

# origin_repo: owner/repo from the origin remote when it is on github.com.
origin_repo() {
  git -C "$MAIN" remote get-url origin 2> /dev/null \
    | sed -nE 's#^(git@|ssh://git@|https://)([^@/]*@)?github\.com[:/]([^/]+/[^/]+)$#\3#p' \
    | sed 's/\.git$//'
}

REPO="$(cfg 'ledger repo')"
REPO="${REPO:-$(origin_repo)}"
MODE="$(cfg ledger | tr 'A-Z' 'a-z')"
if [ -z "$MODE" ]; then
  MODE=file
  [ -n "$REPO" ] && command -v gh > /dev/null && gh auth token > /dev/null 2>&1 && MODE=github
fi
case "$MODE" in github | file) ;; *) die "Ledger setting must be github or file, not '$MODE'" ;; esac
[ "$MODE" = file ] || [ -n "$REPO" ] || die "Ledger is github but no Ledger repo is set and origin is not on GitHub"
PROJECT="$(cfg project)"
PLAN_DIR="$(cfg 'plan dir')"
PLAN_DIR="${PLAN_DIR:-.agents/plans}"
RUN="${LEDGER_RUN:-}"
THROTTLE="${LEDGER_THROTTLE:-1}"

pause() { [ "$THROTTLE" = 0 ] || sleep "$THROTTLE"; }

# exclude <path>: keep a ledger file out of git without touching .gitignore.
exclude() {
  git -C "$MAIN" check-ignore -q "$1" 2> /dev/null && return 0
  local ex
  ex="$(git -C "$MAIN" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$ex")"
  echo "/$1" >> "$ex"
}

# text <file|-|data:b64>: copy the text into a temp file and print its path.
text() {
  local out
  out="$(mktemp "$TMP/text.XXXXXX")"
  case "$1" in
    -) cat > "$out" ;;
    data:*) printf '%s' "${1#data:}" | base64 --decode > "$out" ;;
    *) [ -f "$1" ] || die "no such file: $1" && cat "$1" > "$out" ;;
  esac
  echo "$out"
}

# quiet: escape every @mention so a post notifies nobody (a zero-width space after @).
quiet() { sed -E "s/(^|[^A-Za-z0-9_.\`/-])@([A-Za-z0-9])/\1@$ZW\2/g"; }

# section_replace <name> <file>: stdin body with the named section's content replaced.
section_replace() {
  awk -v name="$1" -v file="$2" '
    $0 == "<!-- ledger:" name " -->" { print; while ((getline l < file) > 0) print l; skip = 1; next }
    $0 == "<!-- /ledger:" name " -->" { skip = 0 }
    !skip'
}

# section_append <name> <line>: stdin body with a line added at the end of the section.
section_append() {
  awk -v name="$1" -v line="$2" '
    $0 == "<!-- /ledger:" name " -->" { print line }
    { print }'
}

# body_of <n>: an issue body without trailing blank lines.
body_of() {
  gh issue view "$1" -R "$REPO" --json body --jq .body \
    | awk '{ a[NR] = $0 } END { n = NR; while (n > 0 && a[n] == "") n--; for (i = 1; i <= n; i++) print a[i] }'
}

section_get() {
  awk -v name="$1" '
    $0 == "<!-- /ledger:" name " -->" { on = 0 }
    on
    $0 == "<!-- ledger:" name " -->" { on = 1 }'
}

run_body() {
  cat << EOF
<!-- ledger:run -->
**Goal:** $1

## Now

<!-- ledger:now -->
Planning.
<!-- /ledger:now -->

## Plan

<!-- ledger:plan -->
Not imported yet.
<!-- /ledger:plan -->

## Rulings

<!-- ledger:rulings -->
<!-- /ledger:rulings -->
EOF
}

# parse_plan <plan.md> <dir>: dir/preamble.md, dir/tasks.tsv (name wave tier deps goal),
# ("-" for none), and dir/task-<name>.md holding each task section verbatim.
parse_plan() {
  awk -v dir="$2" '
    function flush() {
      if (name == "") return
      printf "%s\t%s\t%s\t%s\t%s\n", name, wave, tier, (deps == "" ? "-" : deps), (goal == "" ? name : goal) >> (dir "/tasks.tsv")
    }
    function field(s,   v) {
      v = s; sub(/^[^:]*:\*\*[[:space:]]*/, "", v); gsub(/`/, "", v); sub(/[[:space:]]+$/, "", v); return v
    }
    /^## Task:[[:space:]]*/ {
      flush()
      name = $0; sub(/^## Task:[[:space:]]*/, "", name); gsub(/[`[:space:]]/, "", name)
      wave = "-"; tier = "fast"; deps = ""; goal = ""
      out = dir "/task-" name ".md"; printf "" > out; next
    }
    /^##? / { flush(); name = ""; out = "" }
    out == "" { print >> (dir "/preamble.md"); next }
    {
      print >> out
      line = $0; sub(/^[[:space:]]*[-*][[:space:]]*/, "", line)
      if (line ~ /^\*\*Goal:\*\*/ && goal == "") goal = field(line)
      else if (line ~ /^\*\*Wave:\*\*/) wave = field(line)
      else if (line ~ /^\*\*Tier:\*\*/) { tier = field(line); sub(/[^a-z].*/, "", tier) }
      else if (line ~ /^\*\*Depends on:\*\*/) {
        deps = field(line); if (tolower(deps) ~ /^none/) deps = ""
        gsub(/[[:space:]]/, "", deps)
      }
    }
    END { flush() }' "$1"
  touch "$2/tasks.tsv" "$2/preamble.md"
}

# ---------------------------------------------------------------- GitHub mode

OWNER="${REPO%%/*}"
NAME="${REPO#*/}"

gq() { gh api graphql "$@"; }

# run_number: the open run epic, or --run.
run_number() {
  [ -n "$RUN" ] && {
    echo "${RUN#\#}"
    return
  }
  local runs
  runs="$(gh issue list -R "$REPO" --label run --state open --limit 20 --json number,title \
    --jq '.[] | "\(.number)\t\(.title)"')"
  [ -n "$runs" ] || die "no open run in $REPO; start one with 'ledger init <goal>'"
  if [ "$(printf '%s\n' "$runs" | wc -l)" -gt 1 ]; then
    printf '%s\n' "$runs" >&2
    die "more than one open run; pass --run N"
  fi
  printf '%s\n' "$runs" | cut -f1
}

# subissues <run>: number, state, task name and node id for each sub-issue.
subissues() {
  gq -F n="$1" -f owner="$OWNER" -f name="$NAME" -f query='
    query($owner: String!, $name: String!, $n: Int!) {
      repository(owner: $owner, name: $name) { issue(number: $n) {
        subIssues(first: 100) { nodes { number state title id } } } } }' \
    --jq '.data.repository.issue.subIssues.nodes[] | "\(.number)\t\(.state)\t\(.title | split(": ")[0])\t\(.id)"'
}

# task_number <task>: an issue number from a number, #n or a task name.
task_number() {
  case "$1" in
    '') usage ;;
    \#*) echo "${1#\#}" ;;
    *[!0-9]*)
      local n
      n="$(subissues "$(run_number)" | awk -F'\t' -v t="$1" '$3 == t { print $1; exit }')"
      [ -n "$n" ] || die "no task named '$1' in the run"
      echo "$n"
      ;;
    *) echo "$1" ;;
  esac
}

LABEL_CACHE=""
ensure_label() {
  [ -n "$LABEL_CACHE" ] || LABEL_CACHE="$(gh label list -R "$REPO" --limit 1000 --json name --jq '.[].name')"
  printf '%s\n' "$LABEL_CACHE" | grep -qxF "$1" && return 0
  gh label create "$1" -R "$REPO" --color "${2:-ededed}" --description "${3:-Coordinator ledger}" --force > /dev/null
  LABEL_CACHE="$LABEL_CACHE
$1"
}

gh_labels() {
  local l
  while IFS='|' read -r l c d; do
    gh label create "$l" -R "$REPO" --color "$c" --description "$d" --force > /dev/null
  done << 'EOF'
run|5319e7|A coordinator run: goal, plan, now, rulings
task|c5def5|A coordinator task
state:planned|ededed|Planned, not started
state:building|fbca04|A builder is on it
state:verifying|1d76db|A verifier is on it
state:fixing|d93f0b|Back with the builder after a failed verify
state:passed|0e8a16|Verified; waiting for its wave to land
state:blocked|b60205|Waiting on the owner or a credential
tier:deep|5319e7|Deep-tier builder
tier:fast|bfdadc|Fast-tier builder
EOF
  say "labels ready in $REPO"
}

# project_state <issue url> <state>: mirror State into the project board, best effort.
project_state() {
  [ -n "$PROJECT" ] || return 0
  local owner="${PROJECT%/*}" num="${PROJECT##*/}" item field opt
  [ "$owner" != "$PROJECT" ] || owner="$OWNER"
  {
    item="$(gh project item-add "$num" --owner "$owner" --url "$1" --format json --jq .id)" \
      && field="$(gh project field-list "$num" --owner "$owner" --format json \
        --jq '.fields[] | select(.name == "State") | .id')" \
      && opt="$(gh project field-list "$num" --owner "$owner" --format json \
        --jq ".fields[] | select(.name == \"State\") | .options[]? | select((.name | ascii_downcase) == \"$2\") | .id")" \
      && pid="$(gh project view "$num" --owner "$owner" --format json --jq .id)" \
      && { [ -z "$field" ] || [ -z "$opt" ] || gh project item-edit --id "$item" --project-id "$pid" \
        --field-id "$field" --single-select-option-id "$opt" > /dev/null; }
  } 2> /dev/null || say "project $PROJECT not updated (labels still are); check the gh 'project' scope"
}

gh_init() {
  [ -n "$1" ] || usage
  gh_labels
  mkdir -p "$MAIN/.agents"
  exclude "$PLAN_DIR/"
  run_body "$1" | quiet > "$TMP/body.md"
  local url
  url="$(gh issue create -R "$REPO" --title "Run: $1" --label run --body-file "$TMP/body.md")"
  say "opened run $url"
  echo "${url##*/}"
}

gh_import() {
  local plan="$1" run epic_id url n name wave tier deps goal d labels
  [ -f "$plan" ] || die "no such plan: $plan"
  parse_plan "$plan" "$TMP"
  [ -s "$TMP/tasks.tsv" ] || die "no '## Task: <name>' sections in $plan"
  if [ -z "$RUN" ] && [ -z "$(gh issue list -R "$REPO" --label run --state open --json number --jq '.[].number')" ]; then
    goal="$(grep -m1 '\*\*Goal:\*\*' "$TMP/preamble.md" | sed 's/.*\*\*Goal:\*\*[[:space:]]*//')"
    RUN="$(gh_init "${goal:-$(basename "$plan" .md)}")"
  fi
  run="$(run_number)"
  : > "$TMP/new.txt"
  epic_id="$(gh issue view "$run" -R "$REPO" --json id --jq .id)"
  subissues "$run" > "$TMP/existing.tsv"
  while IFS=$'\t' read -r name wave tier deps goal; do
    n="$(awk -F'\t' -v t="$name" '$3 == t { print $1; exit }' "$TMP/existing.tsv")"
    if [ -n "$n" ]; then
      say "$name exists as #$n; skipped"
      continue
    fi
    labels="task,state:planned"
    case "$tier" in deep | fast) labels="$labels,tier:$tier" ;; esac
    if [ "$wave" != "-" ]; then
      ensure_label "wave:$wave" c5def5 "Wave $wave"
      labels="$labels,wave:$wave"
    fi
    quiet < "$TMP/task-$name.md" > "$TMP/t.md"
    url="$(gh issue create -R "$REPO" --title "$(printf '%s: %s' "$name" "$goal" | quiet)" --label "$labels" --body-file "$TMP/t.md")"
    pause
    gq -f p="$epic_id" -f u="$url" -f query='
      mutation($p: ID!, $u: String!) { addSubIssue(input: {issueId: $p, subIssueUrl: $u}) { issue { number } } }' > /dev/null
    project_state "$url" planned
    echo "$name" >> "$TMP/new.txt"
    say "created ${url##*/} $name"
    pause
  done < "$TMP/tasks.tsv"
  body_of "$run" > "$TMP/run.md"
  if section_get plan < "$TMP/run.md" | grep -qx 'Not imported yet.'; then
    quiet < "$TMP/preamble.md" > "$TMP/pre.md"
    section_replace plan "$TMP/pre.md" < "$TMP/run.md" > "$TMP/run2.md"
  elif [ -s "$TMP/new.txt" ] && grep -q '[^[:space:]]' "$TMP/preamble.md"; then
    {
      section_get plan < "$TMP/run.md"
      printf '\n### Added %s from %s\n\n' "$(date +%F)" "$(basename "$plan")"
      quiet < "$TMP/preamble.md"
    } > "$TMP/pre.md"
    section_replace plan "$TMP/pre.md" < "$TMP/run.md" > "$TMP/run2.md"
  fi
  [ ! -f "$TMP/run2.md" ] || gh issue edit "$run" -R "$REPO" --body-file "$TMP/run2.md" > /dev/null
  # Dependencies: GitHub "blocked by" links. The task body keeps its "Depends on" line either way.
  subissues "$run" > "$TMP/all.tsv"
  while IFS=$'\t' read -r name wave tier deps goal; do
    [ "$deps" != - ] && grep -qxF "$name" "$TMP/new.txt" || continue
    n="$(awk -F'\t' -v t="$name" '$3 == t { print $4; exit }' "$TMP/all.tsv")"
    for d in ${deps//,/ }; do
      d="$(awk -F'\t' -v t="$d" '$3 == t { print $4; exit }' "$TMP/all.tsv")"
      [ -n "$d" ] || continue
      gq -f i="$n" -f b="$d" -f query='
        mutation($i: ID!, $b: ID!) { addBlockedBy(input: {issueId: $i, blockingIssueId: $b}) { issue { number } } }' \
        > /dev/null 2>&1 || true
      pause
    done
  done < "$TMP/tasks.tsv"
  awk -F'\t' -v r="$REPO" 'NR == FNR { want[$1] = 1; next } ($3 in want) { print $3 "\t" r "#" $1 }' \
    "$TMP/tasks.tsv" "$TMP/all.tsv"
}

STATES=" planned building verifying fixing passed blocked merged dropped "

gh_state() {
  local n st="$2" round="" rm add cur
  [ -n "$2" ] || usage
  [ "${3:-}" = --round ] && round="${4:?--round needs a number}"
  case "$STATES" in *" $st "*) ;; *) die "unknown state '$st'; use one of:$STATES" ;; esac
  n="$(task_number "$1")"
  case "$st" in
    merged) gh issue close "$n" -R "$REPO" --reason completed > /dev/null ;;
    dropped) gh issue close "$n" -R "$REPO" --reason "not planned" > /dev/null ;;
    *)
      cur="$(gh issue view "$n" -R "$REPO" --json labels,state --jq '(.state), (.labels[].name)')"
      [ "$(printf '%s\n' "$cur" | head -n1)" = OPEN ] || gh issue reopen "$n" -R "$REPO" > /dev/null
      rm="$(printf '%s\n' "$cur" | grep -E '^state:' | grep -vxF "state:$st" | paste -sd, -)"
      add="state:$st"
      if [ -n "$round" ]; then
        ensure_label "round:$round" d93f0b "Fix round $round"
        add="$add,round:$round"
        rm="$(printf '%s\n%s' "$rm" "$(printf '%s\n' "$cur" | grep -E '^round:' | grep -vxF "round:$round")" | grep . | paste -sd, -)"
      fi
      gh issue edit "$n" -R "$REPO" --add-label "$add" ${rm:+--remove-label "$rm"} > /dev/null
      ;;
  esac
  project_state "https://github.com/$REPO/issues/$n" "$st"
  say "#$n is $st${round:+ (round $round)}"
}

gh_note() {
  local n f head=""
  n="$(task_number "$1")"
  f="$(text "${2:?note needs a file or -}")"
  [ "${3:-}" = --head ] && head="${4:?--head needs text}"
  {
    [ -z "$head" ] || printf '**%s**\n\n' "$head"
    cat "$f"
  } | quiet > "$TMP/c.md"
  gh issue comment "$n" -R "$REPO" --body-file "$TMP/c.md"
}

gh_ruling() {
  local n f by="" day run url first
  n="$(task_number "$1")"
  f="$(text "${2:?ruling needs a file or -}")"
  shift 2
  day="$(date +%F)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) by="${2:?}" && shift 2 ;;
      --date) day="${2:?}" && shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$by" ] || die "ruling needs --by: 'in chat', 'relayed by <session>', 'questionnaire'"
  {
    printf '**Owner ruling**, %s, %s\n\n' "$day" "$by"
    sed 's/^/> /' "$f"
  } | quiet > "$TMP/c.md"
  url="$(gh issue comment "$n" -R "$REPO" --body-file "$TMP/c.md")"
  run="$(run_number)"
  first="$(grep -m1 . "$f" | cut -c1-80 | tr -d '[]' | quiet)"
  body_of "$run" | section_append rulings "- $day, $by: [$first]($url)" > "$TMP/run.md"
  gh issue edit "$run" -R "$REPO" --body-file "$TMP/run.md" > /dev/null
  echo "$url"
}

gh_land() {
  local wave="$1" sha="$2" check="" run n t list=""
  [ -n "$sha" ] || usage
  shift 2
  run="$(run_number)"
  subissues "$run" > "$TMP/all.tsv"
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check="${2:?}" && shift 2 && continue ;;
    esac
    case "$1" in
      *[!0-9#]*) n="$(awk -F'\t' -v t="$1" '$3 == t { print $1; exit }' "$TMP/all.tsv")" ;;
      *) n="${1#\#}" ;;
    esac
    [ -n "$n" ] || die "no task named '$1' in the run"
    t="$(awk -F'\t' -v n="$n" '$1 == n { print $3; exit }' "$TMP/all.tsv")"
    body_of "$n" > "$TMP/b.md"
    printf '\n\n**Landed:** %s in wave %s\n' "$sha" "$wave" >> "$TMP/b.md"
    gh issue edit "$n" -R "$REPO" --body-file "$TMP/b.md" > /dev/null
    gh issue close "$n" -R "$REPO" --reason completed > /dev/null 2>&1
    project_state "https://github.com/$REPO/issues/$n" merged
    list="$list #$n ${t:-task},"
    say "#$n landed"
    pause
    shift
  done
  printf '**Wave %s landed:** %s\n\nTasks:%s\n%s' "$wave" "$sha" "${list%,}" "${check:+
Check: $check
}" | quiet > "$TMP/c.md"
  gh issue comment "$run" -R "$REPO" --body-file "$TMP/c.md"
}

gh_now() {
  local run f
  f="$(text "${1:?now needs a file or -}")"
  run="$(run_number)"
  quiet < "$f" > "$TMP/now.md"
  body_of "$run" | section_replace now "$TMP/now.md" > "$TMP/run.md"
  gh issue edit "$run" -R "$REPO" --body-file "$TMP/run.md" > /dev/null
  say "updated Now on #$run"
}

gh_ref() { echo "$REPO#$(task_number "$1")"; }

gh_status() {
  local filter=""
  [ -z "$RUN" ] || filter="select(.number == ${RUN#\#}) |"
  gq -f owner="$OWNER" -f name="$NAME" -f query='
    query($owner: String!, $name: String!) {
      repository(owner: $owner, name: $name) {
        issues(first: 10, states: OPEN, labels: ["run"]) { nodes {
          number title body
          subIssues(first: 100) { nodes {
            number title state stateReason
            labels(first: 20) { nodes { name } }
            blockedBy(first: 10) { nodes { number state } }
            comments(last: 4) { nodes { body } }
          } } } } } }' --jq '
    def name: .title | split(": ")[0];
    def lbl(p): [.labels.nodes[].name | select(startswith(p)) | ltrimstr(p)];
    def st: if .state == "CLOSED" then (if .stateReason == "NOT_PLANNED" then "dropped" else "merged" end)
            else (lbl("state:")[0] // "planned") end;
    def ref: "\(name) #\(.number)";
    .data.repository.issues.nodes[] | '"$filter"' . as $r
    | [$r.subIssues.nodes[] | . + {s: st}] as $t
    | [$t[] | select(.s != "merged" and .s != "dropped")] as $open
    | "Run #\($r.number): \($r.title | ltrimstr("Run: "))",
      "Now:",
      (($r.body | capture("<!-- ledger:now -->\n(?P<x>(?s:.*?))\n<!-- /ledger:now -->").x // "")
        | split("\n") | map(select(length > 0))[:8][] | "  " + .),
      "Wave now: \([$open[] | lbl("wave:")[0] // empty] | sort | .[0] // "-")",
      (["building", "verifying", "fixing", "passed"][] as $s
        | [$open[] | select(.s == $s)] | select(length > 0)
        | "\($s): " + (map(ref + (lbl("round:")[0] // "" | if . == "" then "" else " (round \(.))" end)) | join(", "))),
      ([$open[] | select(.s == "planned")] as $p
        | ([$p[] | select(all(.blockedBy.nodes[]; .state == "CLOSED"))] | select(length > 0)
            | "ready: " + (map(ref) | join(", "))),
          ([$p[] | select(any(.blockedBy.nodes[]; .state != "CLOSED"))] | select(length > 0)
            | "waiting: " + (map(ref) | join(", ")))),
      ($open[] | select(.s == "blocked")
        | "blocked: \(ref): \((.comments.nodes[-1].body // "no reason recorded") | split("\n") | map(select(length > 0))[0][:120])"),
      "merged: \([$t[] | select(.s == "merged")] | length), dropped: \([$t[] | select(.s == "dropped")] | length), open: \($open | length)",
      ($t[] | . as $i | .comments.nodes[] | select(.body | startswith("**Verify"))
        | .body | split("\n")[] | select(test("\\bCLOSE\\b")) | "CLOSE \($i | ref): \(.[:120])"),
      "Rulings: \(($r.body | [scan("\n- [0-9]{4}-[0-9]{2}-[0-9]{2}, ")] | length)) (in the run body)",
      ""'
}

# ------------------------------------------------------------------ file mode

need_file() { [ -f "$FILE" ] || die "no $FILE; start one with 'ledger init <goal>'"; }

file_init() {
  [ -n "$1" ] || usage
  [ ! -f "$FILE" ] || die "$FILE exists; finish or delete that run first"
  mkdir -p "$MAIN/.agents"
  exclude .agents/ledger.md
  exclude "$PLAN_DIR/"
  {
    echo "# Ledger"
    echo
    echo "Written by scripts/ledger. Not committed."
    echo
    run_body "$1"
    printf '\n## Tasks\n\n<!-- ledger:tasks -->\n| Task | Wave | Tier | Depends on | State | Notes |\n| --- | --- | --- | --- | --- | --- |\n<!-- /ledger:tasks -->\n\n## Log\n'
  } > "$FILE"
  say "started $FILE"
}

file_import() {
  local plan="$1" name wave tier deps goal rel
  [ -f "$plan" ] || die "no such plan: $plan"
  parse_plan "$plan" "$TMP"
  [ -s "$TMP/tasks.tsv" ] || die "no '## Task: <name>' sections in $plan"
  if [ ! -f "$FILE" ]; then
    goal="$(grep -m1 '\*\*Goal:\*\*' "$TMP/preamble.md" | sed 's/.*\*\*Goal:\*\*[[:space:]]*//')"
    file_init "${goal:-$(basename "$plan" .md)}"
  fi
  rel="$(realpath "$plan" 2> /dev/null || echo "$plan")"
  rel="${rel#"$MAIN"/}"
  if section_get plan < "$FILE" | grep -qx 'Not imported yet.'; then
    echo "Plan file: $rel" > "$TMP/pre.md"
  else
    {
      section_get plan < "$FILE"
      echo "Plan file: $rel"
    } > "$TMP/pre.md"
  fi
  section_replace plan "$TMP/pre.md" < "$FILE" > "$TMP/f.md" && cat "$TMP/f.md" > "$FILE"
  while IFS=$'\t' read -r name wave tier deps goal; do
    if grep -q "^| $name |" "$FILE"; then
      say "$name exists; skipped"
      continue
    fi
    section_append tasks "| $name | $wave | $tier | ${deps//,/, } | planned | |" < "$FILE" > "$TMP/f.md"
    cat "$TMP/f.md" > "$FILE"
    printf '%s\t%s#%s\n' "$name" "$rel" "$name"
  done < "$TMP/tasks.tsv"
}

# file_row <task> <col> <value>: set one cell of a task's row (5 State, 6 Notes).
file_row() {
  need_file
  grep -q "^| $1 |" "$FILE" || die "no task named '$1' in $FILE"
  awk -v t="$1" -v c="$2" -v v="$3" '
    index($0, "| " t " |") == 1 {
      split($0, a, "|"); a[c + 1] = " " v " "; out = ""
      for (i = 2; i <= 7; i++) out = out "|" a[i]
      print out "|"; next
    } { print }' "$FILE" > "$TMP/f.md"
  cat "$TMP/f.md" > "$FILE"
}

file_log() {
  need_file
  {
    printf '\n### %s %s\n\n' "$(date '+%F %H:%M')" "$1"
    cat "$2"
  } >> "$FILE"
}

file_state() {
  local st="$2" round=""
  [ -n "$2" ] || usage
  [ "${3:-}" = --round ] && round="${4:?--round needs a number}"
  case "$STATES" in *" $st "*) ;; *) die "unknown state '$st'; use one of:$STATES" ;; esac
  file_row "$1" 5 "$st${round:+ (round $round)}"
  say "$1 is $st${round:+ (round $round)}"
}

file_note() {
  local f head=""
  f="$(text "${2:?note needs a file or -}")"
  [ "${3:-}" = --head ] && head="${4:?--head needs text}"
  file_log "$1${head:+: $head}" "$f"
}

file_ruling() {
  local t="$1" f by="" day
  f="$(text "${2:?ruling needs a file or -}")"
  shift 2
  day="$(date +%F)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) by="${2:?}" && shift 2 ;;
      --date) day="${2:?}" && shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$by" ] || die "ruling needs --by: 'in chat', 'relayed by <session>', 'questionnaire'"
  sed 's/^/> /' "$f" > "$TMP/q.md"
  file_log "$t: Owner ruling, $day, $by" "$TMP/q.md"
  section_append rulings "- $day, $by, on $t: $(grep -m1 . "$f" | cut -c1-80)" < "$FILE" > "$TMP/f.md"
  cat "$TMP/f.md" > "$FILE"
}

file_land() {
  local wave="$1" sha="$2" check="" list=""
  [ -n "$sha" ] || usage
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check="${2:?}" && shift 2 && continue ;;
    esac
    file_row "$1" 5 merged
    file_row "$1" 6 "$sha"
    list="$list $1"
    shift
  done
  printf 'Tasks:%s\n%s' "$list" "${check:+Check: $check
}" > "$TMP/c.md"
  file_log "Wave $wave landed: $sha" "$TMP/c.md"
}

file_now() {
  local f
  need_file
  f="$(text "${1:?now needs a file or -}")"
  section_replace now "$f" < "$FILE" > "$TMP/f.md" && cat "$TMP/f.md" > "$FILE"
}

file_ref() {
  need_file
  grep -q "^| $1 |" "$FILE" || die "no task named '$1' in $FILE"
  echo "$(section_get plan < "$FILE" | sed -n 's/^Plan file: //p' | tail -n1)#$1"
}

file_status() {
  need_file
  echo "Ledger: $FILE"
  grep -m1 '^\*\*Goal:\*\*' "$FILE"
  echo "Now:"
  section_get now < "$FILE" | grep . | head -n 8 | sed 's/^/  /'
  section_get tasks < "$FILE" | awk -F'|' 'NR > 2 {
      t = $2; s = $6; gsub(/^ +| +$/, "", t); gsub(/^ +| +$/, "", s); split(s, w, " "); k = w[1]
      if (k == "merged" || k == "dropped") { done[k]++; next }
      by[k] = by[k] (by[k] == "" ? "" : ", ") t (s != k ? " " substr(s, length(k) + 2) : "")
      open++
    }
    END {
      n = split("building verifying fixing passed planned blocked", order, " ")
      for (i = 1; i <= n; i++) if (by[order[i]] != "") print order[i] ": " by[order[i]]
      printf "merged: %d, dropped: %d, open: %d\n", done["merged"], done["dropped"], open
    }'
  grep -c '^- [0-9]\{4\}-' "$FILE" | sed 's/^/Rulings: /' || true
  [ ! -s "$QUEUE" ] || echo "Queued GitHub writes: $(wc -l < "$QUEUE") (run 'ledger sync')"
}

# ---------------------------------------------------------- queue and dispatch

b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

queue() {
  local a line="" first=1
  mkdir -p "$MAIN/.agents"
  exclude .agents/ledger-queue.jsonl
  for a in "$@"; do
    case "$a" in "$TMP"/*) a="data:$(base64 < "$a" | tr -d '\n')" ;; esac
    [ $first = 1 ] || line="$line,"
    line="$line\"$(b64 "$a")\""
    first=0
  done
  echo "{\"at\":\"$(date -u +%FT%TZ)\",\"args\":[$line]}" >> "$QUEUE"
  say "GitHub is unreachable or rate limited; queued in $QUEUE (replay with 'ledger sync')"
}

online() {
  local r
  r="$(gh api rate_limit --jq '"\(.resources.core.remaining) \(.resources.graphql.remaining)"' 2> /dev/null)" || return 1
  case " $r " in *" 0 "*) return 1 ;; esac
}

cmd_sync() {
  [ -s "$QUEUE" ] || {
    say "nothing queued"
    return 0
  }
  local line args a i=0 total
  total="$(wc -l < "$QUEUE")"
  while IFS= read -r line; do
    args=()
    while IFS= read -r a; do
      [ -n "$a" ] && args+=("$(printf '%s' "$a" | base64 --decode)")
    done < <(printf '%s\n' "$line" | sed -E 's/.*"args":\[(.*)\]\}$/\1/' | tr ',' '\n' | tr -d '"')
    if ! LEDGER_NO_QUEUE=1 "$SELF" "${args[@]}"; then
      tail -n +"$((i + 1))" "$QUEUE" > "$TMP/q" && cat "$TMP/q" > "$QUEUE"
      die "replay stopped at queued write $((i + 1)) of $total; the rest stay queued"
    fi
    i=$((i + 1))
  done < "$QUEUE"
  : > "$QUEUE"
  say "replayed $i queued writes"
}

dispatch() {
  local sub="$1"
  shift
  case "$sub" in
    config)
      printf 'mode\t%s\nrepo\t%s\nrun\t%s\nproject\t%s\nplan dir\t%s\n' \
        "$MODE" "${REPO:--}" "${RUN:--}" "${PROJECT:--}" "$PLAN_DIR"
      ;;
    labels) [ "$MODE" = file ] && say "file mode has no labels" || gh_labels ;;
    init | import | state | note | ruling | land | now | ref | status) "${MODE/github/gh}_$sub" "$@" ;;
    sync) cmd_sync ;;
    -h | --help | help) usage 0 ;;
    *) usage ;;
  esac
}

ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --run)
      RUN="${2:?--run needs an issue number}"
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done
set -- "${ARGS[@]}"
SUB="${1:-}"

# Read text arguments once, so a queued write keeps them.
case "$SUB" in
  import) [ "${2:-}" != - ] || set -- "$1" "$(text -)" "${@:3}" ;;
  now) [ -z "${2:-}" ] || set -- "$1" "$(text "$2")" "${@:3}" ;;
  note | ruling) [ -z "${3:-}" ] || set -- "$1" "$2" "$(text "$3")" "${@:4}" ;;
esac

case "$SUB" in
  init | import | state | note | ruling | land | now | labels)
    if [ "$MODE" = github ] && [ -z "${LEDGER_NO_QUEUE:-}" ]; then
      if [ -s "$QUEUE" ] && ! (cmd_sync); then
        queue ${RUN:+--run "$RUN"} "$@"
        exit 0
      fi
      rc=0
      LEDGER_NO_QUEUE=1 "$SELF" ${RUN:+--run "$RUN"} "$@" || rc=$?
      [ "$rc" = 0 ] && exit 0
      if ! online; then
        queue ${RUN:+--run "$RUN"} "$@"
        exit 0
      fi
      exit "$rc"
    fi
    ;;
esac
dispatch "$@"
